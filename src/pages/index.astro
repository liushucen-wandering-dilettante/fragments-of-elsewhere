---
import ConstellationAtlas from "../components/ConstellationAtlas.astro";
import PageTransitions from "../components/PageTransitions.astro";
import "../styles/fonts.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>fragments of elsewhere</title>

    <PageTransitions />
  </head>

  <body>
    <ConstellationAtlas />

    <div class="corner-ui">
      <!-- 原有首页导航放在这里 -->
    </div>
  </body>
</html>

<style is:global>
  html,
  body {
    width: 100%;
    height: 100%;
    margin: 0;
    overflow: hidden;
    background: #fff;
  }

  * {
    box-sizing: border-box;
  }

  .corner-ui {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
  }

  .corner-ui a,
  .corner-ui button,
  .corner-ui input,
  .corner-ui [role="button"] {
    pointer-events: auto;
  }
</style>