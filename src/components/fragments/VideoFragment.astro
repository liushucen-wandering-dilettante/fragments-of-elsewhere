---
import fragments from "../../data/fragments.json";
import ReturnMenu from "../ReturnMenu.astro";

interface FollowOption {
  label: string;
  target: string;
}

interface VideoFragmentData {
  id: string;
  type: "video";
  video: string;
  poster?: string;
  alt?: string;
  date?: string;
  location?: string;
  follow?: FollowOption[];
}

interface Props {
  fragment: VideoFragmentData;
}

const { fragment } = Astro.props as Props;

const followOptions =
  fragment.follow ?? [];

const allFragmentIds = fragments.map(
  (item) => String(item.id)
);
---

<article class="video-fragment">
  <div class="follow-menu">
    <span class="follow-trigger">
      <span>follow</span>

      <span
        class="follow-arrow"
        aria-hidden="true"
      >
        ▽
      </span>
    </span>

    {
      followOptions.length > 0 ? (
        <nav
          class="follow-options"
          aria-label="Related fragments"
        >
          {
            followOptions.map((option) => (
              <a
                href={`/fragments/${option.target}/`}
                data-path-label={option.label}
              >
                {option.label}
              </a>
            ))
          }
        </nav>
      ) : (
        <p class="follow-empty">
          no further path
        </p>
      )
    }
  </div>

<main class="video-stage">
  <figure class="video-figure">
    <video
      class="fragment-video"
      src={fragment.video}
      poster={fragment.poster}
      aria-label={
        fragment.alt ??
        `Video fragment ${fragment.id}`
      }
      controls
      playsinline
      preload="metadata"
    >
      Your browser does not support video.
    </video>

    {
      (fragment.location || fragment.date) && (
        <figcaption class="video-caption">
          {[fragment.location, fragment.date]
            .filter(Boolean)
            .join(" | ")}
        </figcaption>
      )
    }
  </figure>
</main>

<div class="return-button">
  <ReturnMenu fragmentId={fragment.id} />
</div>

  <a
    class="path-link"
    href="/path/"
  >
    path
  </a>

  <button
    class="drift-button"
    type="button"
    data-drift
    data-current-id={fragment.id}
    data-fragment-ids={JSON.stringify(
      allFragmentIds
    )}
  >
    <span>drift</span>
    <em>elsewhere</em>
    <span aria-hidden="true">▷</span>
  </button>
</article>

<script>
  // Return

  document
    .querySelectorAll<HTMLButtonElement>(
      "[data-return]"
    )
    .forEach((button) => {
      button.addEventListener("click", () => {
        const previousUrl =
          document.referrer;

        if (previousUrl) {
          const previousOrigin =
            new URL(previousUrl).origin;

          if (
            previousOrigin ===
            window.location.origin
          ) {
            window.history.back();
            return;
          }
        }

        window.location.assign("/");
      });
    });

  // Drift elsewhere

  document
    .querySelectorAll<HTMLButtonElement>(
      "[data-drift]"
    )
    .forEach((button) => {
      button.addEventListener("click", () => {
        const currentId =
          button.dataset.currentId;

        const encodedIds =
          button.dataset.fragmentIds ?? "[]";

        let allIds: string[] = [];

        try {
          const parsedIds: unknown =
            JSON.parse(encodedIds);

          if (Array.isArray(parsedIds)) {
            allIds = parsedIds.filter(
              (id): id is string =>
                typeof id === "string"
            );
          }
        } catch (error) {
          console.error(
            "Could not read fragment IDs:",
            error
          );
        }

        const possibleIds =
          allIds.filter(
            (id) => id !== currentId
          );

        if (possibleIds.length === 0) {
          window.location.assign("/");
          return;
        }

        const randomIndex = Math.floor(
          Math.random() *
            possibleIds.length
        );

        const nextId =
          possibleIds[randomIndex];

        if (!nextId) {
          window.location.assign("/");
          return;
        }

        window.location.assign(
          `/fragments/${encodeURIComponent(
            nextId
          )}/`
        );
      });
    });
</script>

<style>
  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
    background: #fff;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(body),
  button {
    font-family: Verdana, sans-serif;
  }

  .video-fragment {
    position: relative;
    width: 100vw;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    background: #fff;
    color: #111;
    font-family: Verdana, sans-serif;
    font-size: 12px;
  }

  /* 左上角 */

  .project-link {
    position: fixed;
    top: 17px;
    left: 14px;
    z-index: 20;
    display: inline-flex;
    gap: 4px;
    align-items: center;
    color: #111;
    text-decoration: none;
  }

  .project-arrow {
    font-size: 9px;
  }

  /* Follow */

  .follow-menu {
    position: fixed;
    top: 15px;
    right: 14px;
    z-index: 20;
    min-width: 130px;
    padding-bottom: 8px;
    text-align: right;
  }

  .follow-trigger {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    justify-content: flex-end;
  }

  .follow-arrow {
    display: inline-block;
    font-size: 9px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .follow-options {
    position: absolute;
    top: 100%;
    right: 0;
    display: flex;
    min-width: 130px;
    flex-direction: column;
    gap: 5px;
    padding-top: 5px;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-3px);

    transition:
      opacity 180ms ease,
      visibility 180ms ease,
      transform 180ms ease;
  }

  .follow-menu:hover .follow-options,
  .follow-menu:focus-within
    .follow-options {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .follow-menu:hover .follow-arrow,
  .follow-menu:focus-within
    .follow-arrow {
    transform: rotate(180deg);
  }

  .follow-options a {
    color: #999;
    text-decoration: none;
    white-space: nowrap;
  }

  .follow-options a:hover {
    color: #111;
  }

  .follow-empty {
    margin: 5px 0 0;
    color: #aaa;
    opacity: 0;
    visibility: hidden;
  }

  .follow-menu:hover .follow-empty,
  .follow-menu:focus-within
    .follow-empty {
    opacity: 1;
    visibility: visible;
  }

  /* 视频 */
video {
  display: block;
  width: auto !important;
  height: auto !important;
  max-width: 75vw;
  max-height: 75vh;
  aspect-ratio: auto !important;
  object-fit: contain;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}
.video-stage {
  display: grid;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  padding: 68px 40px 58px;
  place-items: center;
}

.video-figure {
  display: flex;
  width: min(75vw, 1400px);
  max-width: 100%;
  margin: 0;
  flex-direction: column;
  align-items: center;
  gap: 12px;
}

.fragment-video {
  display: block;
  width: 100%;
  height: auto;
  max-height: calc(100vh - 170px);
  max-height: calc(100dvh - 170px);
  background: #000;
  object-fit: contain;
}

.video-caption {
  width: 100%;
  color: #777;
  font-family: Verdana, sans-serif;
  font-size: 11px;
  font-weight: normal;
  line-height: 1.5;
  text-align: center;
}
  /* 底部导航 */

  .return-button,
  .drift-button {
    position: fixed;
    bottom: 17px;
    z-index: 20;
    display: inline-flex;
    gap: 4px;
    align-items: center;
    padding: 0;
    border: 0;
    background: transparent;
    color: #111;
    font-family: Verdana, sans-serif;
    font-size: 12px;
    cursor: pointer;
  }

  .return-button {
    left: 14px;
  }

  .drift-button {
    right: 14px;
  }

  .drift-button em {
    color: #999;
    font-style: italic;
  }

  .path-link {
    position: fixed;
    bottom: 17px;
    left: 50%;
    z-index: 20;
    color: #111;
    font-family: Verdana, sans-serif;
    font-size: 12px;
    text-decoration: none;
    transform: translateX(-50%);
  }

  .project-link:hover,
  .path-link:hover,
  .return-button:hover,
  .drift-button:hover {
    opacity: 0.5;
  }

  .project-link:focus-visible,
  .follow-options a:focus-visible,
  .path-link:focus-visible,
  .return-button:focus-visible,
  .drift-button:focus-visible {
    outline: 1px solid #111;
    outline-offset: 4px;
  }

  @media (max-width: 700px) {
    .video-stage {
      padding: 75px 16px 60px;
    }

   .video-figure {
  width: 100%;
}

.fragment-video {
  width: 100%;
  max-width: 100%;
  max-height: calc(100dvh - 170px);
}

.video-caption {
  font-size: 10px;
}

    .project-link {
      max-width: 55vw;
    }
  }

  @media (
    prefers-reduced-motion: reduce
  ) {
    .follow-arrow,
    .follow-options {
      transition: none;
    }
  }
</style>