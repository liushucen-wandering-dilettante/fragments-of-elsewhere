---
import ReturnMenu from "../ReturnMenu.astro";

interface FollowOption {
  label: string;
  labelEn?: string;
  target: string;
}

interface AudioFragmentData {
  id: string;
  type: "audio";
  audio: string;
  title?: string;
  date?: string;
  location?: string;
  description?: string;
  caption?: string;
  follow?: FollowOption[];
}

interface Props {
  fragment: AudioFragmentData;
  allFragmentIds: string[];
}

const { fragment, allFragmentIds } = Astro.props as Props;

const followOptions = fragment.follow ?? [];
const audioDescription =
  fragment.description ?? fragment.caption;
---

<main class="audio-fragment">
  <a class="project-title" href="/">
    fragments of elsewhere
  </a>

  {
    followOptions.length > 0 && (
      <nav class="follow-menu" aria-label="Related fragments">
        <button class="follow-trigger" type="button">
          <span>follow</span>
          <span class="follow-arrow" aria-hidden="true">▽</span>
        </button>

        <div class="follow-options">
          {
            followOptions.map((option) => (
              <a href={`/fragments/${option.target}/`}>
                {option.labelEn ?? option.label}
              </a>
            ))
          }
        </div>
      </nav>
    )
  }

<section class="audio-container">
  <audio
    class="audio-player"
    controls
    preload="metadata"
    src={fragment.audio}
    aria-label={fragment.title ?? fragment.id}
  >
    Your browser does not support this audio file.
  </audio>
</section>

<div class="audio-information">
  {
    (fragment.location || fragment.date) && (
      <p class="audio-meta">
        {[fragment.location, fragment.date]
          .filter(Boolean)
          .join(" | ")}
      </p>
    )
  }

  {
    audioDescription && (
      <p class="audio-caption">
        {audioDescription}
      </p>
    )
  }
</div>

<div class="return-button">
  <ReturnMenu fragmentId={fragment.id} />
</div>

  <button
    class="drift-button"
    type="button"
    data-drift
    data-current-id={fragment.id}
    data-fragment-ids={JSON.stringify(allFragmentIds)}
  >
    <span>drift</span>
    <em>elsewhere</em>
    <span aria-hidden="true">▷</span>
  </button>
</main>

<script>
  function initialiseAudioFragment() {
    const returnButton =
      document.querySelector<HTMLButtonElement>("[data-return]");

    const driftButton =
      document.querySelector<HTMLButtonElement>("[data-drift]");

    returnButton?.addEventListener("click", () => {
      if (window.history.length > 1) {
        window.history.back();
      } else {
        window.location.href = "/";
      }
    });

    driftButton?.addEventListener("click", () => {
      const currentId = driftButton.dataset.currentId ?? "";

      let fragmentIds: string[] = [];

      try {
        fragmentIds = JSON.parse(
          driftButton.dataset.fragmentIds ?? "[]"
        );
      } catch {
        fragmentIds = [];
      }

      const possibleIds = fragmentIds.filter(
        (id) => id !== currentId
      );

      if (possibleIds.length === 0) return;

      const nextId =
        possibleIds[
          Math.floor(Math.random() * possibleIds.length)
        ];

      window.location.href =
        `/fragments/${encodeURIComponent(nextId)}/`;
    });
  }

  initialiseAudioFragment();
</script>
<a href="/path/" class="audio-path-link">path</a>
<style>
  :global(html),
  :global(body) {
    width: 100%;
    min-height: 100%;
    margin: 0;
    background: #ffffff;
  }

  :global(body) {
    font-family: Verdana, Arial, sans-serif;
  }

  .audio-fragment {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    min-height: 100vh;
    padding: 28px 32px;
    color: #111111;
    background: #ffffff;
  }

  .project-title {
    position: fixed;
    top: 28px;
    left: 32px;
    z-index: 10;
    color: inherit;
    font-size: 13px;
    line-height: 1.2;
    text-decoration: none;
  }

  .follow-menu {
    position: fixed;
    top: 28px;
    right: 32px;
    z-index: 20;
    text-align: right;
  }

  .follow-trigger {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 7px;
    margin-left: auto;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .follow-arrow {
    font-size: 12px;
  }

  .follow-options {
    display: flex;
    visibility: hidden;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
    padding-top: 10px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      visibility 160ms ease;
  }

  .follow-options a {
    color: inherit;
    font-size: 13px;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
  }

  .follow-menu:hover .follow-options,
  .follow-menu:focus-within .follow-options {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
  }

  .audio-container {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(520px, calc(100vw - 64px));
    transform: translate(-50%, -50%);
  }

  .audio-player {
    display: block;
    width: 100%;
  }

.audio-information {
  position: fixed;
  bottom: 64px;
  left: 50%;
  width: min(520px, calc(100vw - 64px));
  transform: translateX(-50%);
  color: #777;
  font-family: Verdana, Arial, sans-serif;
  font-size: 11px;
  line-height: 1.6;
  text-align: center;
  overflow-wrap: anywhere;
}

.audio-meta {
  margin: 0;
  font-size: inherit;
}

.audio-caption {
  margin: 8px 0 0;
  font-size: inherit;
  white-space: pre-line;
}

.audio-path-link {
  position: fixed;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 100;

  font-family: Verdana, sans-serif;
  font-size: 14px;
  font-weight: normal;
  color: #000;
  text-decoration: none;
}

.audio-path-link:hover {
  opacity: 0.5;
}

@media (max-width: 640px) {
  .audio-information {
    bottom: 56px;
    width: calc(100vw - 40px);
    font-size: 10px;
  }
}

  .return-button,
  .drift-button {
    position: fixed;
    bottom: 28px;
    z-index: 10;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .return-button {
    left: 32px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .drift-button {
    right: 32px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .drift-button em {
    font-style: italic;
  }

  .project-title:hover,
  .follow-trigger:hover,
  .follow-options a:hover,
  .return-button:hover,
  .drift-button:hover {
    opacity: 0.5;
  }

  @media (max-width: 640px) {
    .audio-fragment {
      padding: 20px;
    }

    .project-title {
      top: 20px;
      left: 20px;
    }

    .follow-menu {
      top: 20px;
      right: 20px;
    }

    .return-button {
      bottom: 20px;
      left: 20px;
    }

    .drift-button {
      right: 20px;
      bottom: 20px;
    }

    .audio-container {
      width: calc(100vw - 40px);
    }
  }
</style>